# Copy to .env and fill in. See docs/04-ARCHITECTURE.md → Environments.
# Neon: pooled URL for the app, unpooled (direct) URL for drizzle-kit migrations. Local = `dev` branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. 32+ random characters for the secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Neon Object Storage of the branch: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3 /
# AWS_REGION from `neon env pull` (Vercel reserves the AWS_* names).
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET_SITE=site-media
NEON_STORAGE_BUCKET_PRIVATE=private-files

# Vercel Cron (overdue invoices, Instagram refresh) and ISR revalidation on publish
CRON_SECRET=
ISR_BYPASS_TOKEN=

# Instagram feed on Beranda (P1-10)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TOKEN_ENCRYPTION_KEY=

PUBLIC_SITE_URL=http://localhost:5173

# Local only: DB specs refuse to run unless this is dev
NEON_BRANCH=dev
# Local only: Playwright login (an owner/user on the dev branch)
E2E_EMAIL=
E2E_PASSWORD=
